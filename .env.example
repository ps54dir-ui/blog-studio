# Blog Studio API 키 (로컬 개발용)
# 이 파일을 .env 로 복사한 뒤 실제 키를 입력하세요.
# .env는 .gitignore에 추가할 것.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === 플랫폼 자동발행 ===

# YouTube (Google Cloud Console > OAuth 2.0 > 사용자 인증 정보)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/oauth/google/callback
# Blog Studio 브라우저 로그인(files (5)/index.html): server.js 가 위 GOOGLE_CLIENT_ID 를 팀원에게 자동 전달
# Netlify 배포 시: Site settings → Environment variables 에 넣고 재배포.
#   · 빌드: scripts/inject-google-client-id.cjs 가 index.html 의 SITE_GOOGLE_CLIENT_ID 로 주입 (Functions 없어도 로그인 가능)
#   · 런타임: /api/blog-studio/google-client-config (Function) 로도 동일 값 제공
# YouTube용과 다른 "웹 애플리케이션" 클라이언트를 쓰려면 여기만 따로 지정 (비우면 GOOGLE_CLIENT_ID 사용)
# BLOG_STUDIO_GOOGLE_CLIENT_ID=
# 관리자 이메일(쉼표 구분). 브라우저에 저장된 admins 가 있으면 그것이 우선
# BLOG_STUDIO_GOOGLE_ADMINS=admin@company.com
# (선택) 팀만 로그인 허용 — 구글 로그인 이메일이 목록에 있을 때만 index → 스튜디오 진입. 비우면 제한 없음
# BLOG_STUDIO_ALLOWED_EMAILS=alice@company.com,bob@company.com
# 스튜디오 설정 「드라이브 연결」 시 폴더 선택(Google Picker)용 브라우저 API 키 — GCP에서「Picker API」사용 설정, 키는 HTTP 리퍼러 제한
# GOOGLE_API_KEY=
# (선택) Blog Studio 전용으로 분리하려면 BLOG_STUDIO_GOOGLE_API_KEY=

# 네이버 (Naver Developers > 애플리케이션 등록 > 블로그 API 권한)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3333/api/oauth/naver/callback

# Instagram / Facebook (Meta for Developers > 앱 > instagram_business_content_publish)
META_APP_ID=
META_APP_SECRET=

# === Supabase (Workbench → DB, 이미지 큐) ===
# 서비스 롤: Project Settings > API (스크립트/Cursor 배치용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 클라이언트만 쓸 때(브라우저): RLS 정책 필수
# SUPABASE_ANON_KEY=
